<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Smoke suite - selects tests by TestNG group, not class.

    Use to validate a build/deployment in under a minute:
      mvn clean test -DsuiteXmlFile=src/test/resources/suites/testng-smoke.xml

    Includes only tests tagged @Test(groups = {"smoke", ...}).
-->
<suite name="Amazon Smoke Suite" verbose="1">

    <listeners>
        <listener class-name="com.amazon.automation.listeners.FrameworkListener"/>
        <listener class-name="com.amazon.automation.listeners.TestListener"/>
    </listeners>

    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.amazon.automation.tests"/>
        </packages>
    </test>

</suite>
